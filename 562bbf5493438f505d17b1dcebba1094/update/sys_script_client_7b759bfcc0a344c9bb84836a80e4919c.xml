        <name>Validate Maintenance Date</name>
        <order/>
        <script><![CDATA[function onSubmit() {
    var maintenanceDate = g_form.getValue('maintenance_date');
    if (maintenanceDate) {
        var today = new GlideDateTime().getLocalDate().toString();
        if (maintenanceDate > today) {
            g_form.addErrorMessage('Maintenance date cannot be in the future.');
            return false;
        }
    }
    return true;
}
]]></script>
